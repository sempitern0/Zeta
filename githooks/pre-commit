#!/usr/bin/env bash
# Lint a snapshot of the index; never rewrite working or staged source files.
set -euo pipefail
cd -- "$(git rev-parse --show-toplevel)"
files=()
while IFS= read -r -d '' path; do
    case "$path" in
        *.sh|*.bash|githooks/pre-commit) files+=("$path") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
((${#files[@]})) || exit 0
if ! command -v shellcheck >/dev/null 2>&1; then
    echo 'ShellCheck is required for staged shell changes. Install it with your package manager.' >&2
    exit 1
fi
snapshot="$(mktemp -d)"
trap 'rm -rf -- "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"
cd -- "$snapshot"
shellcheck -- "${files[@]}"
echo 'Staged shell files passed ShellCheck.'
